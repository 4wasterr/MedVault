{
  "name": "medvault",
  "version": "1.0.0",
  "private": true,
  "description": "MedVault Healthcare Management System",
  "scripts": {
    "dev": "npm run demo --prefix frontend/client",
    "dev:full": "node frontend/scripts/dev.mjs",
    "setup:demo": "npm ci --prefix frontend/client",
    "demo": "npm run demo --prefix frontend/client",
    "client": "npm run dev:full --prefix frontend/client",
    "server": "npm run dev --prefix frontend/server",
    "db:setup": "node scripts/test-postgres-connection.cjs --apply",
    "db:verify": "node scripts/test-postgres-connection.cjs",
    "test:postgres": "node scripts/test-postgres.cjs",
    "build": "npm run build --prefix frontend/client",
    "lint": "npm exec --prefix frontend/client oxlint -- frontend/client/src frontend/pages",
    "test": "npm run test --prefix frontend/server && npm run test --prefix frontend/client",
    "qa": "npm run lint && npm test && npm run build"
  }
}
