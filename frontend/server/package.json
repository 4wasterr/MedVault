    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "entities": "^8.1.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
