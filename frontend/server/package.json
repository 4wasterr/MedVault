{
  "name": "medvault-server",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
