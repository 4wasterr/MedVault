# ====================================================================
# MedVault Server Environment Configuration (PostgreSQL / Linux Mint)
# ====================================================================

# Port for the Node.js API server (default 5000)
PORT=5000

# Server session & encryption secrets (auto-generated if not specified)
# MEDVAULT_JWT_SECRET=your_32_byte_secret_hex_here
# MEDVAULT_ENCRYPTION_KEY=your_32_byte_key_hex_here

# Session durations (minutes)
MEDVAULT_SESSION_MINUTES=480
MEDVAULT_IDLE_MINUTES=30

# ====================================================================
# PostgreSQL Database Configuration
# ====================================================================
# Option 1: Standard Connection URL
DATABASE_URL=postgresql://medvault_user:medvault_secure_password_2026@localhost:5432/medvault

# Option 2: Discrete connection parameters
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=medvault
# PGUSER=medvault_user
# PGPASSWORD=medvault_secure_password_2026
# PGSSLMODE=disable

# Note: If no PostgreSQL instance is connected, MedVault will run in safe
# offline development mode so the app and frontend can still be built and tested.

