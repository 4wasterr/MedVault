# ====================================================================
# MedVault Server Environment Configuration (PostgreSQL / Linux Mint)
# ====================================================================

# Port for the Node.js API server (default 5000)
PORT=5000

# Server session & encryption secrets (auto-generated if not specified)
# MEDVAULT_JWT_SECRET=your_32_byte_secret_hex_here
# MEDVAULT_ENCRYPTION_KEY=your_32_byte_key_hex_here

# Session durations (minutes)
MEDVAULT_SESSION_MINUTES=480
MEDVAULT_IDLE_MINUTES=30

# ====================================================================
# PostgreSQL Database Configuration
# ====================================================================
# Windows -> Linux Mint VirtualBox forwarding. Inside Mint, use port 5432.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=medvault
PGUSER=medvault_user
PGPASSWORD=replace_with_your_generated_database_password
PGSSLMODE=disable

# Alternatively set DATABASE_URL (takes precedence over the discrete settings).
# DATABASE_URL=postgresql://medvault_user:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5433/medvault

# A configured PostgreSQL connection must succeed; startup stops on failure.
# With no PostgreSQL settings, local development uses SQLite.
# MEDVAULT_STORAGE=sqlite explicitly selects local storage.
# Automated unit tests use isolated SQLite databases, regardless of this .env.

